# Backend API URL
VITE_API_URL=http://localhost:5000

# Google Web OAuth Client ID (optional override)
# The Web client ID is primarily defined in src/auth/googleSignInConstants.ts
# You can optionally override it here with VITE_GOOGLE_CLIENT_ID
# Must match Server GOOGLE_CLIENT_ID (they are the same Web OAuth client in Google Cloud Console)
# VITE_GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com