# Backend API URL
VITE_API_URL=http://localhost:5000

# Google OAuth — Web client ID (same as Server GOOGLE_CLIENT_ID). Used for native Android Google Sign-In.
# Also set the same value as plugins.GoogleAuth.serverClientId in capacitor.config.json before `npx cap sync android`.
VITE_GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com