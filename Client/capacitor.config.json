{
  "appId": "in.admeasy.app",
  "appName": "Admeasy",
  "webDir": "dist",
  "server": {
    "url": "https://admeasy.in",
    "cleartext": true,
    "allowNavigation": [
      "admeasy.in",
      "*.admeasy.in"
    ]
  },
  "plugins": {
    "GoogleAuth": {
      "scopes": [
        "profile",
        "email"
      ],
      "serverClientId": "131243298453-f8l1eud7gadl0mgap85smr5le64g7k95.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#0f172a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}